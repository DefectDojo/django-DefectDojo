msgid "Create endpoints that do not already exist"
msgstr "ఇప్పటికే లేని ఎండ్‌పాయింట్‌లను సృష్టించండి"

#: dojo/forms.py
msgid "Add Tags"
msgstr "ట్యాగ్‌లను జోడించండి"

