msgstr ""
"Stempel waktu pembaruan status terakhir (perubahan pada kolom terkait "
"status)."

#: dojo/models.py
msgid "Review Requested By"
msgstr "Tinjauan Diminta Oleh"

#: dojo/models.py
msgid "Documents who requested a review for this finding."
msgstr "Mendokumentasikan siapa yang meminta tinjauan untuk temuan ini."

#: dojo/models.py dojo/templates/dojo/findings_list_snippet.html
