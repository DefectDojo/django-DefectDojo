msgstr "Tingkat keyakinan kerentanan yang disediakan oleh pemindai."

#: dojo/models.py
msgid "The SonarQube issue associated with this finding."
msgstr "Isu SonarQube yang terkait dengan temuan ini."

#: dojo/models.py
msgid "SonarQube issue"
