"A hash over a configurable set of fields that is used for findings "
"deduplication."
msgstr ""
"Hash atas kumpulan kolom yang dapat dikonfigurasi yang digunakan untuk "
"deduplikasi temuan."

#: dojo/models.py
msgid "Line number"
msgstr "Nomor baris"

