msgstr "Điểm phần trăm cho 'B' >="

#: dojo/models.py
msgid "Grade C"
msgstr "Điểm C"

#: dojo/models.py
msgid "Percentage score for a 'C' >="
msgstr "Điểm phần trăm cho 'C' >="

#: dojo/models.py
msgid "Grade D"
msgstr "Điểm D"

#: dojo/models.py
msgid "Percentage score for a 'D' >="
msgstr "Điểm phần trăm cho 'D' >="

#: dojo/models.py
msgid "Grade F"
