#: dojo/models.py
msgid "The severity level of this flaw (Critical, High, Medium, Low, Info)."
msgstr ""
"Mức độ nghiêm trọng của lỗ hổng này (Nghiêm trọng, Cao, Trung bình, Thấp, "
"Thông tin)."

