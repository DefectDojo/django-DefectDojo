#: dojo/models.py
msgid "Enable GITHUB integration"
msgstr "GITHUB-integratie inschakelen"

#: dojo/models.py
msgid "Enable Slack notifications"
msgstr "Slack-meldingen inschakelen"

#: dojo/models.py
msgid "Optional. Needed if you want to send global notifications."
msgstr "Optioneel. Nodig als u globale meldingen wilt verzenden."

#: dojo/models.py
