msgid "Authorize User for Products"
msgstr "Авторизувати користувача для продуктів"

#: dojo/user/views.py
#, python-format
msgid "Authorized %(username)s for %(count)d product(s)."
msgstr "Авторизовано %(username)s для %(count)d продукту(ів)."

#: dojo/user/views.py
msgid "Authorize User for Product Types"
msgstr "Авторизувати користувача для типів продуктів"

#: dojo/user/views.py
#, python-format
msgid "Authorized %(username)s for %(count)d product type(s)."
msgstr "Авторизовано %(username)s для %(count)d типу(ів) продуктів."

#: dojo/user/views.py
#, python-format
msgid "Revoked %(username)s from %(product)s."
msgstr "Відкликано %(username)s з %(product)s."

#: dojo/user/views.py
#, python-format
msgid "Revoked %(username)s from %(pt)s."
msgstr "Відкликано %(username)s з %(pt)s."

