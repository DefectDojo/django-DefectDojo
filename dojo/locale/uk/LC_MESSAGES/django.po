msgid "API Key generated successfully."
msgstr "Ключ API успішно згенеровано."

#: dojo/user/views.py
msgid "You have logged out successfully."
msgstr "Ви успішно вийшли з системи."

#: dojo/user/views.py
msgid "Alerts removed."
msgstr "Попередження видалено."

#: dojo/user/views.py
msgid "Profile updated successfully."
msgstr "Профіль успішно оновлено."

#: dojo/user/views.py
#, python-format
msgid "User Profile - %(user_full_name)s"
msgstr "Профіль користувача - %(user_full_name)s"

