#: dojo/announcement/views.py
msgid "Announcement removed for everyone."
msgstr "Duyuru herkes için kaldırıldı."

#: dojo/announcement/views.py
msgid "Announcement updated successfully."
msgstr "Duyuru başarıyla güncellendi."

#: dojo/announcement/views.py
