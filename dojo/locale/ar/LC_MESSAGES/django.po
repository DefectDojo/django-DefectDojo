#: dojo/asset/labels.py
msgid "Please choose month and year and the Asset Tag."
msgstr "يُرجى اختيار الشهر والسنة ووسم الأصل."

#: dojo/asset/labels.py
msgid "Critical Asset Metrics"
msgstr "مقاييس الأصول الحرجة"

#: dojo/asset/labels.py
