msgid ""
"EPSS percentile for the CVE. Describes how many CVEs are scored at or below "
"this one."
msgstr ""
"Percentile EPSS per il CVE. Descrive quanti CVE hanno un punteggio pari o "
"inferiore a questo."

#: dojo/models.py dojo/templates/dojo/findings_list_snippet.html
#: dojo/templates_classic/dojo/findings_list_snippet.html
msgid "Known Exploited"
msgstr "Sfruttamento noto"

#: dojo/models.py
msgid ""
"Whether this vulnerability is known to have been exploited in the wild."
msgstr ""
"Indica se è noto che questa vulnerabilità sia stata sfruttata in the wild."

#: dojo/models.py dojo/templates/dojo/findings_list_snippet.html
#: dojo/templates_classic/dojo/findings_list_snippet.html
msgid "Used in Ransomware"
msgstr "Usato in ransomware"

#: dojo/models.py
msgid ""
"Whether this vulnerability is known to have been leveraged as part of a "
"ransomware campaign."
msgstr ""
"Indica se è noto che questa vulnerabilità sia stata sfruttata come parte di "
"una campagna ransomware."

#: dojo/models.py
msgid "KEV Date Added"
msgstr "Data di aggiunta KEV"

