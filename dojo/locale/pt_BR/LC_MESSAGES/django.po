msgstr "Pontuação percentual para um 'C' >="

#: dojo/models.py
msgid "Grade D"
msgstr "Nota D"

#: dojo/models.py
msgid "Percentage score for a 'D' >="
msgstr "Pontuação percentual para um 'D' >="

#: dojo/models.py
msgid "Grade F"
msgstr "Nota F"

