msgstr ""
"جب فعال ہو، تو خطرے کی قبولیت ختم ہونے پر نتائج کے لیے SLA دوبارہ شروع کر "
"دیا جاتا ہے۔"

#: dojo/models.py
msgid ""
"This dismissable message will be displayed on all pages for authenticated "
