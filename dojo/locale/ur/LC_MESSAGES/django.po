msgstr ""
"کمزوری کے لیے عددی CVSSv3 اسکور۔ اگر ویکٹر دیا گیا ہو، تو نتیجہ محفوظ کرتے "
"وقت اسکور اپ ڈیٹ ہو جاتا ہے۔ قدر 0-10 کے درمیان ہونی چاہیے۔"

#: dojo/models.py
msgid "CVSS4 vector"
msgstr "CVSS4 ویکٹر"

