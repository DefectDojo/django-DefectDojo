msgstr "Asset व्यवस्थापक"

#: dojo/asset/labels.py
msgid "The global role will be applied to all Organizations and Assets."
msgstr "जागतिक भूमिका सर्व Organizations आणि Assets वर लागू केली जाईल."

#: dojo/asset/labels.py
